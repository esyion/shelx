{
  "schema": [
    {
      "path": "appearance.theme",
      "group": "appearance",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "system",
          "dark",
          "light"
        ]
      },
      "default": "system"
    },
    {
      "path": "appearance.language",
      "group": "appearance",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "zh",
          "en"
        ]
      },
      "default": "zh"
    },
    {
      "path": "terminal.fontFamily",
      "group": "terminal",
      "unit": "字符",
      "kind": {
        "kind": "text",
        "maxLen": 200
      },
      "default": "Cascadia Mono, Consolas, monospace"
    },
    {
      "path": "terminal.fontSize",
      "group": "terminal",
      "unit": "px",
      "kind": {
        "kind": "int",
        "min": 8,
        "max": 32,
        "presets": [
          10,
          11,
          12,
          13,
          14,
          15,
          16,
          18,
          20,
          22,
          24,
          28,
          32
        ]
      },
      "default": 13.0
    },
    {
      "path": "terminal.lineHeight",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "float",
        "min": 1.0,
        "max": 2.0,
        "presets": [
          1.0,
          1.1,
          1.2,
          1.3,
          1.4,
          1.5,
          1.75,
          2.0
        ]
      },
      "default": 1.2
    },
    {
      "path": "terminal.colorScheme",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "dracula",
          "tokyo_night",
          "one_dark",
          "nord",
          "solarized_dark",
          "solarized_light",
          "github_light"
        ]
      },
      "default": "github_light"
    },
    {
      "path": "terminal.cursorStyle",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "bar",
          "block",
          "underline"
        ]
      },
      "default": "bar"
    },
    {
      "path": "terminal.scrollback",
      "group": "terminal",
      "unit": "行",
      "kind": {
        "kind": "int",
        "min": 100,
        "max": 100000,
        "presets": [
          1000,
          5000,
          10000,
          50000,
          100000
        ]
      },
      "default": 5000.0
    },
    {
      "path": "terminal.copyOnSelect",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "terminal.rightClickPaste",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "terminal.confirmCloseTab",
      "group": "terminal",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "connection.keepaliveIntervalSecs",
      "group": "connection",
      "unit": "秒",
      "kind": {
        "kind": "int",
        "min": 0,
        "max": 600,
        "presets": [
          0,
          15,
          30,
          60,
          120,
          300,
          600
        ]
      },
      "default": 30.0
    },
    {
      "path": "connection.defaultAuthMethod",
      "group": "connection",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "password",
          "private_key",
          "keyboard_interactive",
          "agent"
        ]
      },
      "default": "password"
    },
    {
      "path": "transfer.maxConcurrentTasks",
      "group": "transfer",
      "unit": "个",
      "kind": {
        "kind": "int",
        "min": 1,
        "max": 8,
        "presets": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8
        ]
      },
      "default": 2.0
    },
    {
      "path": "transfer.chunkSizeKib",
      "group": "transfer",
      "unit": "KiB",
      "kind": {
        "kind": "int",
        "min": 4,
        "max": 1024,
        "presets": [
          16,
          32,
          64,
          128,
          256,
          1024
        ]
      },
      "default": 32.0
    },
    {
      "path": "transfer.defaultConflictPolicy",
      "group": "transfer",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "ask",
          "overwrite",
          "skip",
          "rename"
        ]
      },
      "default": "ask"
    },
    {
      "path": "transfer.notifyOnComplete",
      "group": "transfer",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": false
    },
    {
      "path": "monitor.defaultIntervalSecs",
      "group": "monitor",
      "unit": "秒",
      "kind": {
        "kind": "int",
        "min": 2,
        "max": 60,
        "presets": [
          2,
          5,
          10,
          30,
          60
        ]
      },
      "default": 5.0
    },
    {
      "path": "update.autoCheck",
      "group": "update",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "window.closeToTray",
      "group": "window",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": false
    },
    {
      "path": "agent.approvalMode",
      "group": "agent",
      "unit": null,
      "kind": {
        "kind": "enum",
        "options": [
          "read_only_auto",
          "all_confirm",
          "read_only_only"
        ]
      },
      "default": "read_only_auto"
    },
    {
      "path": "agent.maxTurns",
      "group": "agent",
      "unit": "轮",
      "kind": {
        "kind": "int",
        "min": 1,
        "max": 60,
        "presets": [
          4,
          8,
          12,
          20,
          40
        ]
      },
      "default": 12.0
    },
    {
      "path": "agent.contextMessages",
      "group": "agent",
      "unit": "条",
      "kind": {
        "kind": "int",
        "min": 2,
        "max": 400,
        "presets": [
          10,
          30,
          60,
          120
        ]
      },
      "default": 30.0
    },
    {
      "path": "agent.batchLimit",
      "group": "agent",
      "unit": "台",
      "kind": {
        "kind": "int",
        "min": 1,
        "max": 20,
        "presets": [
          1,
          5,
          10,
          20
        ]
      },
      "default": 5.0
    },
    {
      "path": "agent.parallelHosts",
      "group": "agent",
      "unit": "台",
      "kind": {
        "kind": "int",
        "min": 1,
        "max": 8,
        "presets": [
          1,
          2,
          4,
          8
        ]
      },
      "default": 4.0
    },
    {
      "path": "agent.execTimeoutSecs",
      "group": "agent",
      "unit": "秒",
      "kind": {
        "kind": "int",
        "min": 1,
        "max": 120,
        "presets": [
          10,
          30,
          60,
          120
        ]
      },
      "default": 30.0
    },
    {
      "path": "agent.tokenBudget",
      "group": "agent",
      "unit": "tokens",
      "kind": {
        "kind": "int",
        "min": 0,
        "max": 5000000,
        "presets": [
          0,
          50000,
          200000,
          1000000,
          5000000
        ]
      },
      "default": 1000000.0
    },
    {
      "path": "agent.injectMemories",
      "group": "agent",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "agent.showReasoning",
      "group": "agent",
      "unit": null,
      "kind": {
        "kind": "bool"
      },
      "default": true
    },
    {
      "path": "migration.pendingMigrationId",
      "group": "migration",
      "unit": null,
      "kind": {
        "kind": "hidden"
      },
      "default": null
    },
    {
      "path": "migration.dismissedAutoMigrations",
      "group": "migration",
      "unit": null,
      "kind": {
        "kind": "hidden"
      },
      "default": []
    }
  ],
  "defaults": {
    "appearance": {
      "theme": "system",
      "language": "zh"
    },
    "terminal": {
      "fontFamily": "Cascadia Mono, Consolas, monospace",
      "fontSize": 13,
      "lineHeight": 1.2,
      "colorScheme": "github_light",
      "cursorStyle": "bar",
      "scrollback": 5000,
      "copyOnSelect": true,
      "rightClickPaste": true,
      "confirmCloseTab": true
    },
    "connection": {
      "keepaliveIntervalSecs": 30,
      "defaultAuthMethod": "password"
    },
    "transfer": {
      "maxConcurrentTasks": 2,
      "chunkSizeKib": 32,
      "defaultConflictPolicy": "ask",
      "notifyOnComplete": false
    },
    "monitor": {
      "defaultIntervalSecs": 5
    },
    "update": {
      "autoCheck": true
    },
    "window": {
      "closeToTray": false
    },
    "agent": {
      "maxTurns": 12,
      "contextMessages": 30,
      "batchLimit": 5,
      "parallelHosts": 4,
      "execTimeoutSecs": 30,
      "approvalMode": "read_only_auto",
      "tokenBudget": 1000000,
      "injectMemories": true,
      "showReasoning": true
    },
    "migration": {
      "pendingMigrationId": null,
      "dismissedAutoMigrations": []
    }
  }
}
